gpt_image_playground-main
MagicalCanvas-main/
# testing
coverage/

# next.js
.next/
out/

# production
build/
out.zip

# misc
.DS_Store
*.pem

# database & images (backend)
backend/nova-tasks.sqlite*
backend/nova-images/
backend/data/
backend/ccode-tasks.sqlite*
backend/ccode-images/

# 插件包（backend/plugins/）
# ccode-h3 随仓库分发：它既是参考实现，也是协议的测试基线——后端测试和前端
# schema 测试都直接读它的真实 JSON，忽略掉会让 clone 下来的仓库测试跑不过。
# 其余插件不进主仓库：官方合集在独立的插件仓库维护，运维直接把目录放进
# backend/plugins/ 即可，这条规则保证工作副本不会因此变脏。
backend/plugins/*
!backend/plugins/ccode-h3/
# IDE/Editor configs
.arts/
.claude/
.vscode/
.cursor/
.codebuddy/
.trae/
.codex/
.agents/
# docs/ 随仓库分发（README 截图 + 插件开发文档），不再忽略

data/
# Docker Compose 运行时在根目录复制的配置（勿提交）
/blacklist.json
/prompts.json
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend temp files
backend/.env
backend/.env.local

# frontend build output
frontend/out/
frontend/.next/

# PWA build artifacts
frontend/public/sw.js
frontend/public/workbox-*.js

# local build/debug artifacts
/temp/
/release/
/.jspace/
/server.js

