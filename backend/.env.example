# 本地开发 / 本地生产环境变量模板
# 用法：cp backend/.env.example backend/.env
# npm run dev / npm start 时 cwd=backend

# 服务器配置
# 监听端口（默认：3000）
PORT=3000

# 绑定地址（默认：0.0.0.0，表示所有网络接口）
HOSTNAME=0.0.0.0

# 本服务的公网地址，使用视频模型必须配置。上游要能匿名访问 <此地址>/api/nova/plugin-media/<文件名> 才能拉到参考素材；不配置时按反代头 / Host 头推断，内网部署必须显式配置。
# NOVA_PUBLIC_BASE_URL=https://your-domain.example.com

# 运行环境（development | production）
NODE_ENV=production

# SQLite 数据库文件路径（相对 cwd=backend）
NOVA_TASK_DB=./data/nova-tasks.sqlite

# 图片存储目录（相对 cwd=backend）
NOVA_IMAGE_DIR=./data/nova-images

# 最大并发图片数
NOVA_TASK_CONCURRENCY=50

# 任务清理时间，即任务在多少小时后过期被清理（默认：12）
NOVA_TASK_TTL_HOURS=12

# ============================================
# 队列与限流配置（运行时读取，修改 .env 后通常无需重启）
# ============================================

# 全局最大待处理任务数（排队中 + 生成中），达到后返回 503 QUEUE_FULL
NOVA_MAX_QUEUE_SIZE=200

# 限流窗口长度（毫秒）
NOVA_RATE_LIMIT_WINDOW_MS=60000

# 单 IP 在一个窗口内最多创建多少个任务，超过返回 429 RATE_LIMITED
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_IP=10

# 单 API Key 在一个窗口内最多创建多少个任务，超过返回 429 RATE_LIMITED
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_API_KEY=10

# 单 IP 最多同时拥有多少个待处理任务，超过返回 429 TOO_MANY_PENDING_TASKS
NOVA_MAX_PENDING_TASKS_PER_IP=20

# 单 API Key 最多同时拥有多少个待处理任务，超过返回 429 TOO_MANY_PENDING_TASKS
NOVA_MAX_PENDING_TASKS_PER_API_KEY=20

# 队列满/限流时返回给客户端的 Retry-After 秒数
NOVA_RATE_LIMIT_RETRY_AFTER_SECONDS=60

# ============================================
# 提示词广场配置（运行时读取，修改 .env 后通常无需重启）
# ============================================

# 提示词广场模式：1=常驻（直接显示） 2=私密（需密码验证，点七下标题） 3=关闭（完全隐藏）
# 修改 .env 文件后实时生效，无需重启服务
PROMPT_GALLERY_MODE=1
PROMPT_GALLERY_PASSWORD=8848

# ============================================
# 浏览器 CDP 网络工具（本地/桌面场景，连接本机 Chrome 调试端口）
# ============================================

# CDP 总开关（默认：false；仅本地调试/桌面场景需要时显式设为 true，需重启生效）
# 本地开启：NOVA_CDP_ENABLED=true（CDP 路由仍只允许 loopback 客户端）
NOVA_CDP_ENABLED=false

# 本机 Chrome 调试端口地址与端口（默认：127.0.0.1:9222，运行时读取，修改后无需重启）
NOVA_CDP_HOST=127.0.0.1
NOVA_CDP_PORT=9222

# CDP 请求超时时间，单位毫秒（默认：20000，热生效）
NOVA_CDP_TIMEOUT_MS=20000

# 是否允许从应用内一键启动调试浏览器（默认：true，热生效；仅本地/桌面场景有意义）
NOVA_CDP_LAUNCH_ENABLED=true

# 是否允许 /api/nova/cdp/evaluate 在页面内执行任意 JS（默认：false，热生效；风险较高，仅调试时开启）
NOVA_CDP_EVAL_ENABLED=false

# 商品素材落盘目录（默认：NOVA_IMAGE_DIR 同级的 cdp-products，需重启生效）
# NOVA_CDP_DIR=./data/cdp-products

# 覆盖浏览器可执行文件路径（默认：自动探测，需重启生效）
# NOVA_CHROME_PATH=

# ============================================
# 视频插件（backend/plugins/）
# ============================================

# 插件目录（缺省 backend/plugins）
# NOVA_PLUGINS_DIR=./plugins

# 参考素材落盘目录（缺省 backend/data/plugin-media）
# NOVA_PLUGIN_MEDIA_DIR=./data/plugin-media

# 未绑定任务的孤儿素材保留时长（毫秒，缺省 24 小时）
NOVA_PLUGIN_MEDIA_TTL_MS=86400000

# 参考素材的单文件体积上限（字节）。上游只能通过 URL 拉取素材，
# 所以这些文件会先落在本机，注意磁盘容量。
NOVA_MEDIA_MAX_IMAGE_BYTES=10485760
NOVA_MEDIA_MAX_VIDEO_BYTES=52428800
NOVA_MEDIA_MAX_AUDIO_BYTES=15728640

# 浏览器 CDP 自动化（Agent 模式下通过本机 Chrome 抓取商品与页面素材）
# NOVA_CDP_ENABLED=true
# NOVA_CDP_LAUNCH_ENABLED=true
