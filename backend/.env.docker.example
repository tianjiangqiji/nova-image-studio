# Docker Compose 专用环境变量模板
# 用法：cp backend/.env.docker.example .env
# 挂载到容器 /app/.env（cwd=/app）

# 服务器配置
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# 本服务的公网地址。上游要能匿名访问 <此地址>/api/nova/plugin-media/<文件名> 才能拉到参考素材；不配置时按反代头 / Host 头推断，内网部署必须显式配置。
# NOVA_PUBLIC_BASE_URL=https://your-domain.example.com

# 数据路径（相对容器 cwd=/app；对应宿主机 ./data 挂载到 /app/backend/data）
NOVA_TASK_DB=backend/data/nova-tasks.sqlite
NOVA_IMAGE_DIR=backend/data/nova-images

# 最大并发图片数
NOVA_TASK_CONCURRENCY=50

# 任务清理时间，即任务在多少小时后过期被清理（默认：12）
NOVA_TASK_TTL_HOURS=12

# ============================================
# 队列与限流配置（运行时读取，修改 .env 后通常无需重启）
# ============================================

NOVA_MAX_QUEUE_SIZE=200
NOVA_RATE_LIMIT_WINDOW_MS=60000
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_IP=10
NOVA_RATE_LIMIT_MAX_REQUESTS_PER_API_KEY=10
NOVA_MAX_PENDING_TASKS_PER_IP=20
NOVA_MAX_PENDING_TASKS_PER_API_KEY=20
NOVA_RATE_LIMIT_RETRY_AFTER_SECONDS=60

# ============================================
# 提示词广场配置（运行时读取，修改 .env 后通常无需重启）
# ============================================

# 1=常驻 2=私密（点七下标题） 3=关闭
PROMPT_GALLERY_MODE=1
PROMPT_GALLERY_PASSWORD=8848

# ============================================
# 浏览器 CDP 网络工具（本地/桌面场景，连接 Chrome 调试端口）
# ============================================

# CDP 总开关（默认 false；仅本地调试需要时显式设为 true，重启生效）
# 即使开启，/api/nova/cdp/* 也只允许 loopback 客户端访问。
NOVA_CDP_ENABLED=false

# Chrome 调试端口地址与端口（默认 127.0.0.1:9222，热生效）
NOVA_CDP_HOST=127.0.0.1
NOVA_CDP_PORT=9222

# CDP 请求超时时间，单位毫秒（默认 20000，热生效）
NOVA_CDP_TIMEOUT_MS=20000

# 一键启动调试浏览器（默认 true，热生效；仅桌面版适用，Docker 容器内无效）
NOVA_CDP_LAUNCH_ENABLED=true

# 在页面内执行任意 JS（默认 false，热生效；默认关闭，仅调试时开启）
NOVA_CDP_EVAL_ENABLED=false

# 商品素材落盘目录（默认 NOVA_IMAGE_DIR 同级的 cdp-products，重启生效）
# NOVA_CDP_DIR=backend/data/cdp-products

# 覆盖浏览器可执行文件路径（默认自动探测，重启生效）
# NOVA_CHROME_PATH=
